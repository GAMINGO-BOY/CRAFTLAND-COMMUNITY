datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id        String    @id @default(cuid())
  title     String
  isPinned  Boolean   @default(false)
  pinnedAt  DateTime? 
  blocks    Json      // Text, Image, Audio, Video, Poll, Code blocks yahan save honge
  comments  Comment[]
  createdAt DateTime  @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      String
  text      String
  parentId  String?  // Nested replies ke liye
  createdAt DateTime @default(now())
}
